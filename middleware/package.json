{
  "name": "@a11ign/foresay",
  "version": "0.0.0",
  "description": "Playwright middleware. Predicts what the NVDA screen reader would say, built on NVDA's open-source code, and attaches it to each test while your existing tests run. Not affiliated with NV Access. A prediction, never evidence (a11ign ADR 0047). A preview: private, published nowhere.",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/announcement-emulator.git",
    "directory": "middleware"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./reporter": {
      "types": "./dist/reporter.d.mts",
      "default": "./dist/reporter.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "foresay": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "pins.json",
    "supported-versions.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "devDependencies": {
    "@a11ign/toolchain": "0.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@rslib/core": "1.0.3",
    "@rstest/core": "0.12.3",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "rstest run"
  }
}
