{
  "manifest_version": 3,
  "name": "ae-spike-tree",
  "version": "0.0.1",
  "key": "",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "automation": {
    "desktop": true,
    "interact": true,
    "matches": [
      "<all_urls>"
    ]
  }
}