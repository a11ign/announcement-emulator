# Every revision the emulator is measured with, in one place: setup.sh (a checkout, for development) and middleware/bundle/build.sh (the runtime bundle the Playwright
# middleware downloads) both read this file, so the two cannot drift. Plain shell assignments; nothing else belongs here.

NVDA_TAG=release-2026.1.1
NVDA_REV=5d92106f17e461dac62aa48257bbbf4183e033d0          # tag release-2026.1.1 (2026-05-18), the release the fleet runs
CLDR_REV=6d3ba86c3963f023550a4b1aa8160945e77ca423          # nvaccess/nvda-cldr, the emoji and symbol names NVDA's tests are run with
ARIA_REV=84b921a0                                          # w3c/aria-practices as NVDA's include/ pins it (the tests load pages from it); setup.sh only
CHROME=155.0.8059.84                                       # Chrome for Testing, milestone 155 as the fleet's Edge 155.0.4283.x. Not in the runtime bundle (the middleware runs in the team's Playwright Chromium, A11-230): setup.sh downloads it for development sessions (emu/session.mjs), and build.sh reads the Chromium sources at this tag for the mapping tables

# The Python NVDA's source needs (its pyproject requires >=3.13,<3.14): setup.sh installs it with uv, which downloads these same python-build-standalone builds; the bundle takes
# the build itself, from this release, and refuses it unless its sha256 is the one below (the release's own SHA256SUMS).
PYTHON=3.13.16
PBS_RELEASE=20261013
PBS_SHA256_LINUX_X64=e588e50db882fa6a89f926d9a9ad64e445183af0eda5bda226a2c151b17db8a6
PBS_SHA256_DARWIN_ARM64=ca0e6a70fb75a0984751bd75493e3de77680aef7fbd0fea9b903c299537b3423
# The packages NVDA's source imports that are not Windows-only
SETUPTOOLS=84.0.0      # what uv built fast-diff-match-patch with when the emulator was measured
PYTHON_PACKAGES="configobj==5.0.9 fast-diff-match-patch==2.1.0 nh3==0.3.2 pyserial==3.5 requests==2.32.5 rpyc==6.0.2 schedule==1.2.2 url-normalize==2.2.1 plumbum==2.0.2"

# Chromium's Windows accessibility mapping, as read: the tables are generated from these (emu/gen_tables.py); ax_object.cc is Blink's, read for the access key (PN.keyboard_shortcut)
CHROMIUM_FILES="ui/accessibility/platform/ax_platform_node_win.cc ui/accessibility/platform/ax_platform_node_base.cc ui/accessibility/platform/ax_platform_node_delegate.h
                ui/accessibility/ax_role_properties.cc ui/accessibility/ax_node.cc third_party/iaccessible2/ia2_api_all.idl
                third_party/blink/renderer/modules/accessibility/ax_object.cc"
